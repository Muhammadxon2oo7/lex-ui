# Court backend (LexSim backend v1.4: live procedure, cloned role voices, GPU STT, NLU, case store, xAPI).
# Unset = the economic-court case is hidden and actors fall back to the browser voice. See docs/COURT_BACKEND.md
LEXSIM_REMOTE_URL=https://lex-api.e-investment.uz/api/v1
# Server-to-server key from the backend owner (never commit, never send to the browser).
# With it: every room gets the server voice; without it, only students with a court session open.
LEXSIM_REMOTE_KEY=
